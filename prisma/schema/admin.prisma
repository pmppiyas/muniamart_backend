model Admin {
  id       String      @id @default(cuid())
  name     String
  email    String      @unique
  password String
  photoUrl String?
  role     AdminRole   @default(ADMIN)
  status   AdminStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("admins")
}
