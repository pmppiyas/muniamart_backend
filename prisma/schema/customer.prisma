model Customer {
  id       String         @id @default(cuid())
  name     String
  email    String         @unique
  password String
  phone    String?
  photoUrl String?
  status   CustomerStatus @default(ACTIVE)

  cart     Cart?
  wishlist Wishlist?
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("customers")
}
